# ─── Environment ───────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=iisms
DB_USER=root
DB_PASS=

# ─── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OTP / Email ──────────────────────────────────────────
OTP_DEV_MODE=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── File Uploads ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=2097152

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
